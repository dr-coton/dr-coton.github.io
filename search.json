---
layout: null
---
[
  {% assign writings = site.writings | sort: 'title' %}
  {% for writing in writings %}
  {
    "url": {{ writing.url | relative_url | jsonify }},
    "title": {{ writing.title | jsonify }},
    "topic": {{ writing.topic | jsonify }},
    "description": {{ writing.description | jsonify }},
    "content": {{ writing.content | strip_html | normalize_whitespace | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
